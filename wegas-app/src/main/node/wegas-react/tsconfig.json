{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext",
      "dom"
    ],
    "allowJs": false,
    "checkJs": false,
    "resolveJsonModule": true,
    "jsx": "react",
    "sourceMap": true,
    "noEmit": true,
    "isolatedModules": true,

    "strict": true,
    "strictFunctionTypes": false,
    // "noUncheckedIndexedAccess": true, // 479 errors rn

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "noImplicitReturns": true, // 54 errors rn
    "noFallthroughCasesInSwitch": true,

    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  }
}
