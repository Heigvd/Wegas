# Disable http2 between the proxy and Payara. Upgrading from HTTP/1.1 to HTTP/2 brings nothing to it,
# and it potentially brings strange behaviours.
# What we end up with:
#   Between the client and the reverse proxy  => HTTP/2 (standard internet)
#   Between the reverse proxy and our backend => HTTP/1.1 (local network)
set configs.config.server-config.network-config.protocols.protocol.http-listener.http.http2-enabled=false
set configs.config.server-config.network-config.protocols.protocol.https-listener.http.http2-enabled=false
